<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\XMobile.Shared\XMobile.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="8.0.10" />
    <!-- Derives snake_case column names from PascalCase C# properties (e.g. EmployeeCode ->
         employee_code), matching db/schema exactly without a HasColumnName() on every property.
         Table names/schemas are still set explicitly per entity (one schema per module). -->
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RootNamespace>XMobile.Persistence</RootNamespace>
  </PropertyGroup>

  <!--
    Schema-first: db/schema/*.sql is the source of truth (triggers bump row_version/updated_at
    and write sync.change_log; EF never generates schema). Entity configurations map onto it —
    see Conventions.cs for the syncable-column and client-generated-key helpers every module's
    IEntityTypeConfiguration uses, and XMobilePostgres.cs for the enum/PostGIS data-source wiring.
  -->

</Project>
